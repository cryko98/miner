# --- Storage (Upstash Redis via Vercel Marketplace; auto-injected as KV_REST_API_* too) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth: random 32+ char string for signing login tokens ---
AUTH_SECRET=

# --- Token: pump.fun contract address. Leave empty until launch; the holder
# --- check (100k $MINER) activates automatically when this is set.
TOKEN_MINT=

# --- Solana RPC (Helius etc. recommended; public mainnet RPC is rate limited) ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Reward wallet. Public key is derived from the secret; set REWARD_WALLET
# --- alone to just display the balance without enabling payouts.
REWARD_WALLET=
REWARD_WALLET_SECRET=

# --- Payouts: % of reward wallet balance distributed each 15-min round ---
PAYOUT_PCT=5

# --- Secret the external cron sends as "Authorization: Bearer <CRON_SECRET>" ---
CRON_SECRET=
